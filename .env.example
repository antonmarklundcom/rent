# ---------------------------------------------------------------------------
# alquilar.com.py — every environment variable the app knows about.
# Copy to .env.local (Next.js) / .env (scripts run with tsx) and fill in.
# Missing values never break the build: features degrade gracefully (plan §4.5).
# ---------------------------------------------------------------------------

# MySQL connection string. Hostinger: hPanel > Databases > Management.
# Remote access requires whitelisting your IP under "Remote MySQL".
# Format: mysql://user:password@host:3306/database
DATABASE_URL="mysql://user:password@localhost:3306/alquilar"

# 32+ character random string used to encrypt the iron-session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-32-character-or-longer-random-string"

# Bootstrap super_admin created by `npm run seed` (and on first run in prod).
SEED_SUPER_ADMIN_EMAIL="admin@alquilar.com.py"
SEED_SUPER_ADMIN_PASSWORD="change-me"
SEED_SUPER_ADMIN_NAME="Super Admin"

# VenderCRM lead forwarding. Without these, leads are stored locally and
# marked forward_status = 'pending' (never lost).
VENDERCRM_API_URL="https://app.vendercrm.com/api/v1/leads"
VENDERCRM_API_KEY=""

# Claude API key for AI-drafted replies (phase O-4). Without it the draft
# action returns a "configure ANTHROPIC_API_KEY" notice instead of failing.
ANTHROPIC_API_KEY=""

# Public base URL — used for canonical URLs, sitemaps, iCal export links,
# magic links sent to cleaners.
NEXT_PUBLIC_SITE_URL="https://alquilar.com.py"

# Google Business Profile review link used by the review-request message
# template (#11). Optional; template renders without it.
GBP_REVIEW_LINK=""
